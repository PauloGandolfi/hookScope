# Apenas para desenvolvimento local. Configure valores próprios fora do Git.
POSTGRES_DB=hookscope
POSTGRES_USER=hookscope
POSTGRES_PASSWORD=hookscope_local
POSTGRES_PORT=5432
DB_URL=jdbc:postgresql://localhost:5432/hookscope
DB_USER=hookscope
DB_PASSWORD=hookscope_local
API_PORT=8080
SESSION_COOKIE_SECURE=false

# Simulador de integrações (use uma chave local real, sem versioná-la)
HOOKSCOPE_API_URL=http://localhost:8080
HOOKSCOPE_API_KEY=
SIMULATOR_INTERVAL_MS=1000
SIMULATOR_EVENT_COUNT=0
SIMULATOR_REQUEST_TIMEOUT_MS=5000
